; Engine configuration file.
; Farpoint HORIZON
; NASA Space Apps Challenge 2026 - Space Mission Design Game

config_version=5

[application]

config/name="Farpoint HORIZON"
config/description="A 3D game to design, launch and operate a complete space mission."
run/main_scene="res://scenes/main.tscn"
config/icon="res://icon.svg"
run/flush_stdout_on_print=true
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

GameData="*res://scripts/game_data.gd"
GameState="*res://scripts/game_state.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[internationalization]

locale/fallback="en"
locale/translations=PackedStringArray("res://i18n/translations.es.translation")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

